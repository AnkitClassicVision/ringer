{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sales_ops.send_queue.v1",
  "title": "Sales Ops Send Queue Row v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "candidate_id",
    "idempotency_key",
    "cohort_name",
    "deal_id",
    "deal_name",
    "pipeline",
    "stage",
    "days_idle",
    "stage_sla_days",
    "stale_reason",
    "recommended_action",
    "draft_subject",
    "draft_body",
    "context_qa",
    "writing_qa",
    "suppression_qa",
    "recent_touch_qa",
    "action_qa",
    "approval_state",
    "status",
    "send_receipt",
    "hubspot_receipt",
    "external_actions_taken",
    "audit"
  ],
  "properties": {
    "schema_version": {"const": "sales_ops.send_queue.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 8},
    "idempotency_key": {"type": "string", "minLength": 8},
    "cohort_name": {"const": "practiceos_stale_active_deals"},
    "deal_id": {"type": "string", "minLength": 1},
    "deal_name": {"type": "string", "minLength": 1},
    "pipeline": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "days_idle": {"type": "integer", "minimum": 0},
    "stage_sla_days": {"type": "integer", "minimum": 0},
    "stale_reason": {"type": "string", "minLength": 1},
    "recommended_action": {"enum": ["send_email"]},
    "draft_subject": {"type": "string", "minLength": 1},
    "draft_body": {"type": "string", "minLength": 1},
    "context_qa": {"enum": ["pass", "hold", "fail"]},
    "writing_qa": {"enum": ["pass", "hold", "fail"]},
    "suppression_qa": {"enum": ["pass", "hold", "fail"]},
    "recent_touch_qa": {"enum": ["pass", "hold", "fail"]},
    "action_qa": {"enum": ["pass", "hold", "fail"]},
    "approval_state": {"enum": ["not_requested", "pending_review", "approved_to_send", "rejected"]},
    "status": {"enum": ["held", "ready_for_approval", "sent_and_logged"]},
    "send_receipt": {"type": ["string", "null"]},
    "hubspot_receipt": {"type": ["string", "null"]},
    "external_actions_taken": {"type": "array"},
    "audit": {"type": "object"}
  },
  "additionalProperties": true
}
