+            match = re.search(r"(?:^|\s)([01]?\d|2[0-3]):([0-5]\d)(?::\d\d)?(?:\s*([ap]m))?", start, re.I)
+            if not match:
+                return (float("inf"), start)
+            hour, minute = int(match.group(1)), int(match.group(2))
