+def _order_availability_slots(slots, time_pref=""):
+    """Apply an opt-in presentation order without changing the CLI query."""
+    pref = str(time_pref or "").strip().lower()
+    if pref in {"latest", "last"}:
+        def start_key(slot):
+            start = str(slot.get("start", "")) if isinstance(slot, dict) else ""
+            for fmt in ("%m/%d/%Y %I:%M %p", "%m/%d/%Y %H:%M", "%Y-%m-%d %H:%M"):
